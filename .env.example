# App settings
ENV=development
DEBUG=True
PORT=8000

# Database (ADR-0001)
DATABASE_URL=sqlite:///./catalogpilot.db

# Store Adapter (ADR-0002, ADR-0009)
STORE_MODE=mock
WOOCOMMERCE_URL=http://localhost:8080
WOOCOMMERCE_CONSUMER_KEY=ck_test_sample_key
WOOCOMMERCE_CONSUMER_SECRET=cs_test_sample_secret

# LLM Provider (ADR-0005)
LLM_PROVIDER=gemini
LLM_MODE=replay
GEMINI_API_KEY=
